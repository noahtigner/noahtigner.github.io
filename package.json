{
  "name": "noahtigner.github.io",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "Noah Tigner",
    "email": "noahzanetigner@gmail.com",
    "url": "https://github.com/noahtigner"
  },
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "build": "react-router build && mv ./dist/client/* ./dist",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tanstack/react-query": "^5.104.1",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "isbot": "^5.2.2",
    "lucide-react": "1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@mdit/plugin-alert": "^2.0.2",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@react-router/dev": "^8.4.0",
    "@types/d3": "^7.4.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "validate-env-vars": "^2.1.0",
    "vite": "^8.3.2",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
