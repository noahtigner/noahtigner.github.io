{
  "name": "noahtigner.github.io",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "Noah Tigner",
    "email": "noahzanetigner@gmail.com",
    "url": "https://github.com/noahtigner"
  },
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "build": "react-router build && mv ./dist/client/* ./dist",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@react-router/node": "^7.13.0",
    "@react-router/serve": "^7.13.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "isbot": "^5.1.34",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@mdit/plugin-alert": "^0.22.4",
    "@mdit/plugin-tasklist": "^0.22.3",
    "@react-router/dev": "^7.13.0",
    "@types/d3": "^7.4.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "front-matter": "^4.0.2",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "validate-env-vars": "^2.0.0",
    "vite": "^7.3.1",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
